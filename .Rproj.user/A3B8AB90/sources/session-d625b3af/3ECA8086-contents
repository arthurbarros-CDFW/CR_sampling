#' @title test_scale_requirements
#'
#' @description fill
#' 
#' @param N
#' 
#' @param theta 
#' 
#' @param k_iterations 
#' 
#' @param tag_rate
#' 
#' @param survey "hatchery" or "trib"
#' 
#' @param scales_n
#' 
#' @return fill
#' 

test_scale_requirements<-function(N,
                                  theta,
                                  k_iterations,
                                  scale_iterations,
                                  tag_rate,
                                  survey,
                                  scales_n_seq,
                                  n_replicates,
                                  CI,
                                  h_prop,
                                  target_moe){
  #create results output to fill
  age_grid <- expand.grid(
    scales_n = scales_n_seq,
    replicate = 1:n_replicates,
    age = 2:4,
    stringsAsFactors = FALSE
  ) %>%
    mutate(
      estimated_prop_natural = NA,
      true_prop_natural = NA,
      bias = NA,
      CI=CI,
      upper_CI_prop = NA,
      lower_CI_prop = NA,
      ci_width_prop = NA,
      upper_CI_count=NA,
      lower_CI_count=NA,
      ci_width_count = NA,
      coverage = NA,
      moe_prop=NA,
      moe_count=NA,
      est_count_natural=NA,
      true_count_natural=NA,
      sim_time = NA,
      scales_sampled=NA,
      age_present_in_sample = FALSE,
      age_present_in_pop = FALSE,
      warning_message = NA_character_,
      true_natural_missed=NA,
      fake_natural_estimated=NA
    )
  
  totals_grid<-expand.grid(
    scales_n = scales_n_seq,
    replicate = 1:n_replicates,
    stringsAsFactors = FALSE
  ) %>%
    mutate(
      estimated_prop_natural = NA,
      true_prop_natural = NA,
      bias = NA,
      CI=CI,
      upper_CI_prop = NA,
      lower_CI_prop = NA,
      ci_width_prop = NA,
      upper_CI_count=NA,
      lower_CI_count=NA,
      ci_width_count = NA,
      coverage = NA,
      moe_prop=NA,
      moe_count=NA,
      est_count_natural=NA,
      true_count_natural=NA,
      sim_time = NA,
      scales_sampled=NA,
      warning_message = NA_character_,
      true_natural_missed=NA,
      fake_natural_estimated=NA
    )
  
  #run for loops over scales_n_seq and n_replicates
  for(r in 1:n_replicates){
    
    #simulate population
    pop<-sim_pop(N = N,tag_rate=tag_rate,h_prop=h_prop)
    
    for(s in seq_along(scales_n_seq)){

      #run simulation with current scales_n
      time_start<-Sys.time()
      spawning_results<-sim_spawning_recovery(pop,theta,tag_rate,k_iterations)
      sim_result<-tryCatch({
        sim_scales_sampling(
          pop=pop,
          spawning_results,
          theta=theta,
          k_iterations=k_iterations,
          scale_iterations=scale_iterations,
          tag_rate=tag_rate,
          survey="trib",
          scales_n=scales_n_seq[s],
          CI=CI
        )
      },error=function(e){
        message(paste("Error in simulation:", e$message))
        return(NULL)
      })
      
      time_end<-Sys.time()
      sim_time<-time_end-time_start
      
      #skip if simulation failed
      if (is.null(sim_result)) {
        warning_msg <- "sim_wrapper failed"
        for (a in 2:4) {
          idx <- which(age_grid$scales_n == scales_n_seq[s] &
                         age_grid$replicate == r & 
                         age_grid$age == a)
          if (length(idx) > 0) {
            age_grid$warning_message[idx] <- warning_msg
            age_grid$sim_time[idx] <- sim_time
          }
        }
        print(paste("FAILED: scales_n =", scales_n_seq[s],
                    "boot iteration =", r))
        next
      }
      
      age_summary_stats=sim_result$age_summary_stats
      true_summary_stats=sim_result$true_summary_stats
      overall_summary_stats=sim_result$overall_summary_stats
      scales_sampled=sim_result$scales_collected
      
      #store age results
      for(a in 2:4){
        
        #get row index for values to fill
        idx_age<-which(age_grid$scales_n==scales_n_seq[s] &
                     age_grid$replicate==r & 
                     age_grid$age==a)
        
        if (length(idx_age) == 0) next
        
        est_row <- which(age_summary_stats$age == a)
        
        if (length(est_row) > 0) {
          age_grid$estimated_prop_natural[idx_age] <- age_summary_stats$mean_proportion_natural[age_summary_stats$age == a]
          age_grid$true_prop_natural[idx_age] <- true_summary_stats$true_proportion_natural[true_summary_stats$age == a]
          age_grid$bias[idx_age] <- age_grid$estimated_prop_natural[idx_age] - age_grid$true_prop_natural[idx_age]
         
          age_grid$est_count_natural[idx_age]<-age_summary_stats$est_count_natural[age_summary_stats$age==a]
          age_grid$true_count_natural[idx_age]<-true_summary_stats$true_count_natural[true_summary_stats$age==a]
         
          age_grid$lower_CI_prop[idx_age] <- age_summary_stats$lower_CI_prop[age_summary_stats$age == a]
          age_grid$upper_CI_prop[idx_age] <- age_summary_stats$upper_CI_prop[age_summary_stats$age == a]
          age_grid$lower_CI_count[idx_age] <- age_summary_stats$lower_CI_count[age_summary_stats$age == a]
          age_grid$upper_CI_count[idx_age] <- age_summary_stats$upper_CI_count[age_summary_stats$age == a]
          
          #CI width
          age_grid$ci_width_prop[idx_age] <- age_summary_stats$upper_CI_prop[age_summary_stats$age == a] - 
            age_summary_stats$lower_CI_prop[age_summary_stats$age == a]
          age_grid$ci_width_count[idx_age] <- age_summary_stats$upper_CI_count[age_summary_stats$age == a] - 
            age_summary_stats$lower_CI_count[age_summary_stats$age == a]
          
          #does CI contain true value?
          age_grid$coverage[idx_age] <- 
            age_summary_stats$lower_CI_prop[age_summary_stats$age == a] <= true_summary_stats$true_proportion_natural[true_summary_stats$age == a] &
            age_summary_stats$upper_CI_prop[age_summary_stats$age == a] >= true_summary_stats$true_proportion_natural[true_summary_stats$age == a]
          
          age_grid$moe _prop[idx_age] <-age_grid$ci_width_prop[idx_age]/2
          age_grid$moe_count[idx_age] <-age_grid$ci_width_count[idx_age]/2
          
          age_grid$sim_time[idx_age] <- sim_time
          age_grid$scales_sampled[idx_age]<-scales_sampled
          
          age_grid$age_present_in_sample[idx_age] <- TRUE
          age_grid$age_present_in_pop[idx_age] <- TRUE
          
          #deal with missing or fake natural estimates
          age_grid$true_natural_missed[idx_age]<-ifelse(round(age_grid$est_count_natural[idx_age])==0 & age_grid$true_count_natural[idx_age]>0,
                                                        TRUE,FALSE)
          age_grid$fake_natural_estimated[idx_age]<-ifelse(round(age_grid$est_count_natural[idx_age])>0 & age_grid$true_count_natural[idx_age]==0,
                                                        TRUE,FALSE)
        } else {
          age_grid$estimated_prop_natural[idx_age] <- NA
          age_grid$age_present_in_sample[idx_age] <- FALSE
          age_grid$warning_message[idx_age] <- "No scale samples for this age class"
          
          age_grid$bias[idx_age] <- -age_grid$true_prop_natural[idx_age]  # Bias = 0 - true
          age_grid$lower_CI_prop[idx_age] <- 0
          age_grid$upper_CI_prop[idx_age] <- 0
          age_grid$ci_width[idx_age] <- 0
          age_grid$scales_n<-NA
          age_grid$coverage[idx_age] <- FALSE
        }
      
      }
      
      #do total (san-age)
      #get row index for values to fill
      idx<-which(totals_grid$scales_n==scales_n_seq[s] &
                   totals_grid$replicate==r)
      
      total_true<-true_summary_stats%>%
        group_by()%>%
        summarise(true_count_hatchery=sum(true_count_hatchery),
                  true_count_natural=sum(true_count_natural))%>%
        mutate(true_proportion_natural=true_count_natural/(true_count_natural+true_count_hatchery),
               true_proportion_hatchery=true_count_hatchery/(true_count_natural+true_count_hatchery))
      
      totals_grid$estimated_prop_natural[idx] <- overall_summary_stats$mean_proportion_natural
      totals_grid$true_prop_natural[idx] <- total_true$true_proportion_natural
      totals_grid$bias[idx] <- totals_grid$estimated_prop_natural[idx] - totals_grid$true_prop_natural[idx]
      
      totals_grid$est_count_natural[idx]<-overall_summary_stats$est_total_natural
      totals_grid$true_count_natural[idx]<-total_true$true_count_natural
      
      totals_grid$lower_CI_prop[idx] <- overall_summary_stats$lower_CI_prop
      totals_grid$upper_CI_prop[idx] <- overall_summary_stats$upper_CI_prop
      totals_grid$lower_CI_count[idx] <- overall_summary_stats$lower_CI_total
      totals_grid$upper_CI_count[idx] <- overall_summary_stats$upper_CI_total
      
      #CI width
      totals_grid$ci_width_prop[idx] <- overall_summary_stats$upper_CI_prop - 
        overall_summary_stats$lower_CI_prop
      totals_grid$ci_width_count[idx] <- overall_summary_stats$upper_CI_total - 
        overall_summary_stats$lower_CI_total
      
      #does CI contain true value?
      totals_grid$coverage[idx] <- 
        overall_summary_stats$lower_CI_prop <= total_true$true_proportion_natural &
        overall_summary_stats$upper_CI_prop >= total_true$true_proportion_natural
      
      totals_grid$moe_prop[idx] <-totals_grid$ci_width_prop[idx]/2
      totals_grid$moe_count[idx] <-totals_grid$ci_width_count[idx]/2
      
      totals_grid$sim_time[idx] <- sim_time
      totals_grid$scales_sampled[idx]<-scales_sampled
      
      #deal with missing or fake natural estimates
      totals_grid$true_natural_missed[idx]<-ifelse(round(totals_grid$est_count_natural[idx])==0 & totals_grid$true_count_natural[idx]>0,
                                                    TRUE,FALSE)
      totals_grid$fake_natural_estimated[idx]<-ifelse(round(totals_grid$est_count_natural[idx])>0 & totals_grid$true_count_natural[idx]==0,
                                                       TRUE,FALSE)
      
      print(paste("finished scales_n = ",scales_n_seq[s],
                  " boot iteration = ",r,
                  " time = ",round(sim_time,4),"seconds"))
    }
  }
  return(list(
    "age_results"=age_grid,
    "total_results"=totals_grid)
  )
}
