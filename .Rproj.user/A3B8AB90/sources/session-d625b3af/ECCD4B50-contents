#' @title sim_summary_stats
#'
#' @description Calculates bias and margin of error (MOE) for count and 
#' proportion estimates of natural-origin age classes.
#' 
#' @param data inputs the estimates and true values produced from the 
#' sim_scale_sampling() function.
#' 
#' @return output with count bias, proportional bias, and MOE for each
#' natural-origin age class.

sim_summary_stats<-function(data){
  
  d_ests<-data$est_summary_stats
  d_true<-data$true_summary_stats
  
  d_stats<-d_ests%>%left_join(d_true)%>%
    mutate(count_bias=mean_count_natural-true_count_natural,
           prop_bias=mean_proportion_natural-true_proportion_natural,
           count_moe=(upper_CI_count-lower_CI_count)/2,
           count_moe_relative=count_moe/mean_count_natural,
           prop_moe=(upper_CI_prop-lower_CI_prop)/2)
  d_stats<-select(d_stats,age,
                  count_bias,prop_bias,
                  count_moe,count_moe_relative,
                  prop_moe)
  return(d_stats)
}
